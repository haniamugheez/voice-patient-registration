# ---- Database -------------------------------------------------------------
# Local default is SQLite (no setup needed). On Render, paste the Internal
# Database URL of a Postgres instance here so data survives redeploys.
DATABASE_URL=sqlite:///./data/patients.db

# ---- Vapi -----------------------------------------------------------------
# Any long random string. Put the SAME value in the Vapi dashboard under
# Assistant > Advanced > Server Messages > Secret (header: x-vapi-secret).
VAPI_SERVER_SECRET=change-me-to-a-long-random-string

# ---- App ------------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
SEED_ON_STARTUP=true
